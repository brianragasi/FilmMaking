{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "EcoCart is a PHP, MySQL, XAMPP, HTML, JavaScript, and DaisyUI demo system for the DDoS awareness screenplay.",
  "main": "main.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i assets/app.css -o public/output.css",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "EcoCart",
  "license": "ISC",
  "build": {
    "appId": "com.ecocart.trafficcontrol",
    "productName": "SWARMGRID C2",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "installer"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SWARMGRID C2",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.3.3"
  }
}
